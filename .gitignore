# Rendered figure rasters (regenerate from the .py per repo convention)
artifacts/*.png
artifacts/*.pdf

# Session logs and raw device exports (SpeedCoach CSVs hold the paddler's GPS track)
data/
*.jsonl
*.csv
!tests/**/*.jsonl

__pycache__/
*.pyc

# Packaging
*.egg-info/
build/
dist/

# role-played races: only the role-player's answers are tracked; each race replays
# exactly from them (experiments/roleplay_race.py verify), so the rest is regenerated
results/coaching_trial/roleplay/**
!results/coaching_trial/roleplay/**/
!results/coaching_trial/roleplay/**/answers.json
